# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Telegram Bot Configuration
# ==========================================
# Obtenha com o @BotFather no Telegram: https://t.me/BotFather
TELEGRAM_TOKEN="123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ"

# ID numérico do canal (ex: -1001234567890) ou @nomedocanal público
# O bot deve ser adicionado ao canal como Administrador com permissão de postar!
CANAL_ID="@meu_canal_de_ofertas"

# Username do canal para o link de compartilhamento (opcional, ex: @meu_canal_de_ofertas)
CANAL_USERNAME="@meu_canal_de_ofertas"

# ==========================================
# Shopee Affiliate Open API Configuration
# ==========================================
# Obtenha no painel de afiliados: https://affiliate.shopee.com.br/open_api
SHOPEE_APP_ID="seu_shopee_app_id"
SHOPEE_APP_SECRET="seu_shopee_app_secret"

# Porta do servidor HTTP Flask (para manter o bot vivo no Render/Railway/Fly.io)
PORT=8080
